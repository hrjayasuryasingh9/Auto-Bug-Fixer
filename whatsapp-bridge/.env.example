# Your FastAPI backend URL
API_URL=http://localhost:8000

# GitHub credentials
GITHUB_TOKEN=ghp_your_classic_pat_here
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# Anthropic key (optional — uses server-side key if not set)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only respond to messages from this phone number
# Format: country code + number, no + or spaces  e.g. 919876543210
ALLOWED_NUMBER=
