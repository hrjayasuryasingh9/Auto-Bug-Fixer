# ── Slack (Socket Mode) ───────────────────────────────────────────────────────
# Bot User OAuth Token — Slack app → OAuth & Permissions  (starts with xoxb-)
slack_oauth_token=xoxb-...
# App-Level Token with connections:write — Slack app → Basic Information → App-Level Tokens (starts with xapp-)
slack_api_bot_key=xapp-...
# Signing Secret — Slack app → Basic Information
slack_signing_secret=...

# ── Backend ───────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
# Optional: restrict the bot to a single Slack user id (e.g. U0123ABCD)
# ALLOWED_USER=
