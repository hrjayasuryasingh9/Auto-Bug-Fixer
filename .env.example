# ── WhatsApp Business Cloud API (Meta) ──────────────────────────────────────
# Get these from https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token   # any string you choose
WHATSAPP_APP_SECRET=your_app_secret              # used to verify X-Hub-Signature-256

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used by the intent classifier (/api/intent/) and chat replies.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── GitHub (server-side) ──────────────────────────────────────────────────────
# Credentials are no longer collected per-user over WhatsApp — they live here.
# The repo the assistant answers questions about:
GITHUB_TOKEN=ghp_your_personal_access_token       # classic PAT with `repo` scope
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name

# ── Per-request fields for /api/ai-fix/ (sent in JSON body, NOT env) ───────────
#   repo_url, repo_name, target_file, message  (+ creds if not using env)

# ── WhatsApp bridge (whatsapp-bridge/.env) ────────────────────────────────────
# API_URL=http://localhost:8000
# ALLOWED_NUMBER=1234567890      # optional: restrict the bot to one number
